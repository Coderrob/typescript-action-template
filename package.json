{
  "author": "Robert Lindley (coderrob)",
  "bugs": {
    "url": "https://github.com/Coderrob/typescript-action-template/issues"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "pino": "^9.11.0"
  },
  "optionalDependencies": {
    "pino-pretty": "^13.1.1"
  },
  "description": "A template for creating a TypeScript action for GitHub Actions.",
  "devDependencies": {
    "@github/local-action": "^2.6.1",
    "@jest/globals": "^29.7.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.1",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.20.0",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jest": "^28.11.0",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-sonarjs": "^3.0.5",
    "jest": "^29.7.0",
    "jscpd": "^4.0.5",
    "madge": "^8.0.0",
    "make-coverage-badge": "^1.2.0",
    "prettier": "^3.5.0",
    "rollup": "^4.34.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "homepage": "https://github.com/Coderrob/typescript-action-template",
  "keywords": [
    "actions",
    "github",
    "template",
    "typescript"
  ],
  "license": "Apache-2.0",
  "name": "typescript-action-template",
  "packageManager": "npm@10.0.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Coderrob/update-action-readme.git"
  },
  "scripts": {
    "all": "npm run lint:fix && npm run quality && npm run test && npm run package",
    "copyright": "sh ./script/copyright ./src",
    "coverage": "make-coverage-badge --output-path ./badges/coverage.svg",
    "dev": "local-action . src/index.ts .env",
    "duplication": "jscpd src",
    "lint": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint --fix .",
    "madge": "madge --circular --orphans src",
    "package": "rollup --config rollup.config.js --configPlugin @rollup/plugin-typescript",
    "package:watch": "npm run package -- --watch",
    "quality": "npm run lint && npm run duplication && npm run madge",
    "release": "npm run copyright && sh ./script/release",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest && npm run coverage",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.0.1"
}
